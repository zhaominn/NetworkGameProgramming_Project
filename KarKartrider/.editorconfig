# 이 파일이 프로젝트의 최상위 설정임을 나타냅니다.
root = true

# [*]는 모든 파일에 적용된다는 뜻입니다.
[*]
# Visual Studio에서 한글 깨짐을 막는 가장 확실한 방법입니다.
# '유니코드 (서명 있는 UTF-8) - 코드 페이지 65001'에 해당합니다.
charset = utf-8-bom

# (추가) 줄 끝 문자를 윈도우 스타일(CRLF)로 통일합니다.
end_of_line = crlf

# (추가) C++ 소스 파일은 이 규칙을 확실히 따르도록 지정합니다.
[*.{cpp,h,hpp,c,cxx}]
charset = utf-8-bom